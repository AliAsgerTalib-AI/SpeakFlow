# GEMINI_API_KEY: Required for Gemini AI API calls.
# Injected into the client bundle at build time via Vite's `define` config.
# WARNING: This key will be visible in the compiled JS bundle. Use a backend proxy for production.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GEMINI_MODEL: The specific Gemini model ID to use (e.g., gemini-2.0-flash or gemini-1.5-flash).
# Default fallback in code is gemini-2.0-flash.
GEMINI_MODEL="gemini-3.1-flash-lite-preview"

# Firebase Configuration
# These values are provided by your Firebase project console.
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_APP_ID="YOUR_APP_ID"
VITE_FIREBASE_API_KEY="YOUR_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_AUTH_DOMAIN"
VITE_FIREBASE_DATABASE_ID="YOUR_DATABASE_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_STORAGE_BUCKET"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
