# GEMINI_API_KEY: Required for Gemini AI API calls.
# Injected into the client bundle at build time via Vite's `define` config.
# WARNING: This key will be visible in the compiled JS bundle. Use a backend proxy for production.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GEMINI_MODEL: The specific Gemini model ID to use (e.g., gemini-2.0-flash or gemini-1.5-flash).
# Default fallback in code is gemini-2.0-flash.
GEMINI_MODEL="gemini-2.0-flash"
