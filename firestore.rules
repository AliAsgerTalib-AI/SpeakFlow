rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Auth helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidSession(data) {
      return data.keys().hasAll(['userId', 'timestamp', 'script', 'feedback'])
        && data.userId is string
        && data.timestamp == request.time
        && data.script is string
        && data.feedback is map
        && data.userId == request.auth.uid;
    }

    match /sessions/{sessionId} {
      allow create: if isSignedIn() && isValidSession(request.resource.data);
      allow get, list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update, delete: if false; // Sessions are immutable logs
    }
  }
}
